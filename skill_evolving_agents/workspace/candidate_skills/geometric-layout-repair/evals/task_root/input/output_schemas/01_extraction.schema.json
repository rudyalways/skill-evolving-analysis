{
  "type": "object",
  "required": [
    "schema_version",
    "layer_inventory",
    "rooms",
    "doors",
    "fixtures",
    "grab_bars",
    "turning_space"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "layer_inventory": {
      "type": "array",
      "minItems": 1
    },
    "rooms": {
      "type": "array",
      "minItems": 1
    },
    "doors": {
      "type": "array",
      "minItems": 1
    },
    "fixtures": {
      "type": "array",
      "minItems": 1
    },
    "grab_bars": {
      "type": "array",
      "minItems": 1
    },
    "turning_space": {
      "type": "object",
      "required": [
        "status",
        "diameter",
        "candidates",
        "selected"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "fit"
          ]
        },
        "diameter": {
          "type": "number"
        },
        "candidates": {
          "type": "array",
          "minItems": 1
        },
        "selected": {
          "type": "object"
        }
      }
    }
  }
}
