{
  "schema_version": 1,
  "maximum_layer": 3,
  "maximum_category_depth": 3,
  "category_separator": "/",
  "depth_is_independent_of_step": true,
  "branch_factor": 2,
  "maximum_nodes": 500,
  "layers": {
    "0": "observed_or_declared_id_root",
    "1": "single_axis_boundary_shift",
    "2": "two_axis_composed_ood",
    "3": "bounded_failure_neighborhood"
  },
  "gates": {
    "expand_success_mean_below": 0.8,
    "expand_ci90_width_above": 0.2,
    "expand_on_novel_failure": true,
    "expand_declared_but_unobserved": true
  }
}

