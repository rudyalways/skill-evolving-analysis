{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/schemas/scenario.schema.json",
  "type": "object",
  "required": ["schema_version", "scenario_id", "title", "domain", "distribution", "capabilities", "interface_requirements", "risk", "generator", "oracle", "tags"],
  "properties": {
    "schema_version": {"const": 1},
    "scenario_id": {"type": "string", "pattern": "^[a-z0-9._-]+\\.v[0-9]+$"},
    "title": {"type": "string", "minLength": 3},
    "domain": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "distribution": {"type": "object", "required": ["status", "reference_population", "reason_codes", "confidence"], "properties": {"status": {"enum": ["id_observed", "id_declared", "boundary", "ood_candidate", "ood_confirmed", "unknown"]}, "reference_population": {"type": "string"}, "reason_codes": {"type": "array", "items": {"type": "string"}}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "axis": {"type": "string"}}},
    "capabilities": {"type": "object", "required": ["required", "prohibited", "optional"], "properties": {"required": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "prohibited": {"type": "array", "items": {"type": "string"}}, "optional": {"type": "array", "items": {"type": "string"}}}},
    "interface_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "risk": {"type": "object", "required": ["level", "sandbox_required"], "properties": {"level": {"enum": ["low", "medium", "high"]}, "sandbox_required": {"type": "boolean"}}},
    "generator": {"type": "object", "required": ["kind", "template_id", "prompt", "parameter_schema"], "properties": {"kind": {"type": "string"}, "template_id": {"type": "string"}, "prompt": {"type": "string"}, "parameter_schema": {"type": "object", "required": ["difficulty"], "properties": {"difficulty": {"type": "array", "minItems": 3}}}}},
    "oracle": {"type": "object", "required": ["kind", "checks"], "properties": {"kind": {"type": "string"}, "checks": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "tags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}

