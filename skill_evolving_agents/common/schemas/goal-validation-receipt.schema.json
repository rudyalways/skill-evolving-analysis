{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/celia-hk-agent/skill-evolving-agents/blob/main/skill_evolving_agents/common/schemas/goal-validation-receipt.schema.json",
  "title": "Goal validation receipt",
  "description": "Candidate-bound evidence for one host-owned Goal contract validation attempt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "item",
    "attempt",
    "status",
    "validator",
    "candidate",
    "at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "stage": {"const": "goal"},
    "item": {"type": "string", "minLength": 1, "maxLength": 512},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
    "status": {"enum": ["passed", "failed"]},
    "validator": {"const": "host.goal-contract-v1"},
    "candidate": {"$ref": "#/$defs/candidateIdentity"},
    "at": {"type": "string", "format": "date-time"},
    "error": {"$ref": "#/$defs/contractError"},
    "candidate_snapshot": {"type": ["string", "null"], "maxLength": 65536},
    "candidate_snapshot_redactions": {"type": "integer", "minimum": 0},
    "snapshot_omitted_reason": {
      "enum": ["missing", "larger_than_65536_bytes"]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {"required": ["error"]},
      "else": {
        "not": {
          "anyOf": [
            {"required": ["error"]},
            {"required": ["candidate_snapshot"]},
            {"required": ["candidate_snapshot_redactions"]},
            {"required": ["snapshot_omitted_reason"]}
          ]
        }
      }
    },
    {
      "if": {
        "required": ["candidate_snapshot"],
        "properties": {"candidate_snapshot": {"type": "string"}}
      },
      "then": {"required": ["candidate_snapshot_redactions"]}
    },
    {
      "if": {
        "required": ["candidate_snapshot"],
        "properties": {"candidate_snapshot": {"type": "null"}}
      },
      "then": {"required": ["snapshot_omitted_reason"]}
    }
  ],
  "$defs": {
    "candidateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "present"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "present": {"type": "boolean"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"present": {"const": true}}},
          "then": {"required": ["sha256", "bytes"]},
          "else": {
            "not": {
              "anyOf": [
                {"required": ["sha256"]},
                {"required": ["bytes"]}
              ]
            }
          }
        }
      ]
    },
    "contractError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "type", "message"],
      "properties": {
        "kind": {"const": "contract_invalid"},
        "type": {"type": "string", "minLength": 1, "maxLength": 128},
        "message": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}
