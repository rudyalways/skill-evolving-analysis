{
  "schema_version": 1,
  "machine": "skill-evolution/v1",
  "initial_state": "START",
  "terminal_states": ["COMPLETE", "DEFERRED", "REJECTED", "FAILED"],
  "defaults": {"max_steps": 32, "max_visits_per_state": 3, "on_invalid_transition": "fail"},
  "states": {
    "START": {"kind": "control", "implementations": ["control.start-v1"]},
    "NORMALIZE": {"kind": "deterministic", "implementations": ["normalize.vendor-json-v1"]},
    "DETECT": {"kind": "deterministic", "implementations": ["detect.rules-v1"]},
    "POLICY": {"kind": "control", "implementations": ["policy.fixed-v1", "policy.search-v1", "policy.transformer-v1"]},
    "SEMANTIC_FILTER": {"kind": "embedding-service", "implementations": ["prefilter.embedding-json-v1"]},
    "LABEL_SKILLS": {"kind": "hybrid", "implementations": ["labels.cached-v1", "labels.agent-v1"]},
    "SELECT_UNITS": {"kind": "deterministic", "implementations": ["selection.evidence-gate-v1"]},
    "DIAGNOSE": {"kind": "hybrid", "implementations": ["diagnosis.agent-full-json-v1", "diagnosis.llm-json-no-reasoning-v1", "diagnosis.jev-v1", "diagnosis.inventory-v1"]},
    "RECALL": {"kind": "hybrid", "implementations": ["recall.weighted-path-v1", "recall.embedding-v1", "recall.inventory-v1"]},
    "GOAL": {"kind": "hybrid", "implementations": ["goal.agent-full-json-v1", "goal.llm-json-no-reasoning-v1"]},
    "OPTIMIZE": {"kind": "hybrid", "implementations": ["optimize.agent-v1"]},
    "VERIFY": {"kind": "hybrid", "implementations": ["verify.agent-structural-v1"]},
    "PUBLISH": {"kind": "deterministic", "implementations": ["publish.atomic-v1"]},
    "HUMAN_REVIEW": {"kind": "external", "implementations": ["review.human-v1"]},
    "COMPLETE": {"kind": "terminal", "implementations": []},
    "DEFERRED": {"kind": "terminal", "implementations": []},
    "REJECTED": {"kind": "terminal", "implementations": []},
    "FAILED": {"kind": "terminal", "implementations": []}
  },
  "transitions": [
    {"from": "START", "to": "NORMALIZE", "reasons": ["run_started"]},
    {"from": "START", "to": "LABEL_SKILLS", "reasons": ["inventory_started"]},
    {"from": "NORMALIZE", "to": "DETECT", "reasons": ["normalized"]},
    {"from": "DETECT", "to": "POLICY", "reasons": ["findings_ready"]},
    {"from": "POLICY", "to": "SEMANTIC_FILTER", "reasons": ["semantic_enabled", "semantic_observe"]},
    {"from": "POLICY", "to": "LABEL_SKILLS", "reasons": ["semantic_bypassed"]},
    {"from": "SEMANTIC_FILTER", "to": "LABEL_SKILLS", "reasons": ["filter_complete", "filter_failed_open"]},
    {"from": "LABEL_SKILLS", "to": "SELECT_UNITS", "reasons": ["labels_ready", "labels_reused"]},
    {"from": "SELECT_UNITS", "to": "DIAGNOSE", "reasons": ["units_selected"]},
    {"from": "SELECT_UNITS", "to": "COMPLETE", "reasons": ["no_units"]},
    {"from": "SELECT_UNITS", "to": "DEFERRED", "reasons": ["insufficient_evidence"]},
    {"from": "DIAGNOSE", "to": "RECALL", "reasons": ["diagnosis_complete"]},
    {"from": "DIAGNOSE", "to": "HUMAN_REVIEW", "reasons": ["high_uncertainty", "ood"]},
    {"from": "DIAGNOSE", "to": "DEFERRED", "reasons": ["more_evidence_required"]},
    {"from": "RECALL", "to": "GOAL", "reasons": ["recall_complete", "no_match"]},
    {"from": "RECALL", "to": "HUMAN_REVIEW", "reasons": ["ambiguous_match"]},
    {"from": "GOAL", "to": "OPTIMIZE", "reasons": ["change_proposed"]},
    {"from": "GOAL", "to": "COMPLETE", "reasons": ["no_change"]},
    {"from": "GOAL", "to": "HUMAN_REVIEW", "reasons": ["high_impact", "ambiguous_goal"]},
    {"from": "OPTIMIZE", "to": "VERIFY", "reasons": ["candidate_ready"]},
    {"from": "OPTIMIZE", "to": "FAILED", "reasons": ["optimization_failed"]},
    {"from": "VERIFY", "to": "PUBLISH", "reasons": ["verified"]},
    {"from": "VERIFY", "to": "OPTIMIZE", "reasons": ["retry_with_feedback"], "max_uses": 2},
    {"from": "VERIFY", "to": "REJECTED", "reasons": ["verification_failed", "retry_exhausted"]},
    {"from": "VERIFY", "to": "HUMAN_REVIEW", "reasons": ["verification_uncertain"]},
    {"from": "PUBLISH", "to": "COMPLETE", "reasons": ["published", "publication_skipped"]},
    {"from": "PUBLISH", "to": "FAILED", "reasons": ["publication_failed"]},
    {"from": "HUMAN_REVIEW", "to": "OPTIMIZE", "reasons": ["approved_change"]},
    {"from": "HUMAN_REVIEW", "to": "COMPLETE", "reasons": ["approved_no_change"]},
    {"from": "HUMAN_REVIEW", "to": "REJECTED", "reasons": ["rejected_by_human"]},
    {"from": "HUMAN_REVIEW", "to": "DEFERRED", "reasons": ["review_deferred"]}
  ],
  "immutable_rules": {
    "publish_requires_visit": "VERIFY",
    "publish_implementation": "publish.atomic-v1",
    "failure_states_are_terminal": true,
    "budget_enforcement": "external_control_plane"
  }
}
