{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2024"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": [
      "node"
    ],
    "typeRoots": [
      "../../../../oss/deepseek-harness/node_modules/@types"
    ],
    "paths": {
      "@deepseek-ai/cordis": [
        "../../../../oss/deepseek-harness/vendor/cordis/src/index.ts"
      ],
      "@deepseek-ai/cosmokit": [
        "../../../../oss/deepseek-harness/vendor/cosmokit/src/index.ts"
      ],
      "vitest": [
        "../../../../oss/deepseek-harness/node_modules/vitest/dist/index.d.ts"
      ]
    },
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictFunctionTypes": false
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}
