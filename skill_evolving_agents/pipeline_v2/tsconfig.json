{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2024"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "../../../../oss/deepseek-harness/node_modules/@types"
    ],
    "paths": {
      "vitest": [
        "../../../../oss/deepseek-harness/node_modules/vitest/dist/index.d.ts"
      ]
    },
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictFunctionTypes": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}
