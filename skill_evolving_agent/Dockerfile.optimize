FROM python:3.12-slim

WORKDIR /opt/skill-evolver

COPY skill_evolving_agent/evolver_skills/reference-skill_format skill_evolving_agent/evolver_skills/reference-skill_format
COPY skill_evolving_agent/evolver_skills/step5.2.1-skill-create skill_evolving_agent/evolver_skills/step5.2.1-skill-create
COPY skill_evolving_agent/evolver_skills/step5.2.2-ood-data-updater skill_evolving_agent/evolver_skills/step5.2.2-ood-data-updater
COPY skill_evolving_agent/evolver_skills/step6-verifiter skill_evolving_agent/evolver_skills/step6-verifiter
COPY skill_evolving_agent/evolver_skills/step7-judge skill_evolving_agent/evolver_skills/step7-judge
COPY skill_evolving_agent/optimize-agent.md skill_evolving_agent/AGENT.md
COPY skill_evolving_agent/workspace skill_evolving_agent/workspace
COPY skill_evolving_agent/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

RUN chmod +x /usr/local/bin/docker-entrypoint.sh

WORKDIR /opt/skill-evolver/skill_evolving_agent

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["sleep", "infinity"]
