# Copy this file to .env and fill only the credentials you use.
# Never commit .env or paste its values into issues, logs, or documentation.

# Recommended hosted pipeline provider
DEEPSEEK_API_KEY=
SKILL_EVOLVER_DSH_PATCH=

# Optional hosted providers and gateways
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN=
CURSOR_API_KEY=

# Optional local Recursive/Flint endpoint
FLINT_BASE_URL=http://127.0.0.1:8000/v1
FLINT_API_KEY=

# Optional harness overrides
DSH_BIN=
DSH_PATCH=
HERMES_BIN=
HERMES_HOME=
OPENCLAW_BIN=
OPENCLAW_NODE=
OPENCLAW_CONFIG_PATH=
OPENCLAW_STATE_DIR=

# Optional runtime tuning
SKILL_EVOLVER_SESSION_ROOT=
SKILL_EVOLVER_AGENT_TIMEOUT_SECONDS=180
SKILL_EVOLVER_VERIFIER_TIMEOUT_SECONDS=360
